<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".GlyphBoardApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlyphBoard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible trampoline: the only reliable way to raise the system
             keyboard picker from a service or a tile (see QuickSwitchActivity). -->
        <activity
            android:name=".ui.QuickSwitchActivity"
            android:exported="false"
            android:theme="@style/Theme.GlyphBoard.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleTask" />

        <service
            android:name=".ime.GlyphBoardService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Optional quick-switch accessibility service: adds a keyboard
             toggle to the system accessibility button. Requests no data
             access whatsoever (see accessibility_switch.xml). -->
        <service
            android:name=".ime.KeyboardSwitchService"
            android:exported="true"
            android:label="@string/quick_switch_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_switch" />
        </service>
        <!-- Quick Settings tile: swaps keyboards from anywhere without any
             accessibility service. BIND_QUICK_SETTINGS_TILE is a permission the
             SYSTEM must hold to bind us; it is not a permission this app requests. -->
        <service
            android:name=".ime.QuickSwitchTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_keyboard"
            android:label="@string/quick_switch_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
